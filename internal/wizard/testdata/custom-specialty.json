            {
              "key": "readingB",
              "label": "Lectura B",
              "type": "NUMBER",
              "required": false
            },
            {
              "key": "result",
              "label": "Promedio",
              "type": "FORMULA",
              "required": false,
              "formula": {
                "kind": "CUSTOM",
                "operation": "AVERAGE",
                "inputs": {
                  "a": {
                    "fieldKey": "readingA"
                  },
                  "b": {
                    "fieldKey": "readingB"
                  }
                }
              }
            },
            {
              "key": "notes",
              "label": "Observaciones",
