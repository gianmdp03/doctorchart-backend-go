              "required": true
            },
            {
              "key": "group",
              "label": "Grupo de prueba",
              "type": "SELECT",
              "required": false,
              "options": [
                {
                  "value": "a",
                  "label": "Grupo A"
                },
                {
                  "value": "b",
                  "label": "Grupo B"
                }
              ]
            }
          ]
        }
      ]
    },
    "encounterForm": {
      "categories": [
        {
          "key": "new_encounter_category",
          "title": "Consulta inédita",
          "enabled": true,
          "fields": [
            {
              "key": "readingA",
