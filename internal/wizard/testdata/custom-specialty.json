                {
                  "value": "FEMALE",
                  "label": "Femenino"
                },
                {
                  "value": "OTHER",
                  "label": "Otro"
                },
                {
                  "value": "UNKNOWN",
                  "label": "Sin información"
                }
              ]
            },
            {
              "key": "sys_phone",
              "label": "Teléfono",
              "type": "TEXT",
              "required": false,
              "system": true
            },
            {
              "key": "sys_email",
              "label": "Email",
              "type": "TEXT",
              "required": false,
              "system": true
            },
            {
              "key": "sys_insurance",
              "label": "Obra social / Cobertura",
              "type": "TEXT",
              "required": false,
              "system": true
            }
          ]
        },
        {
          "key": "new_patient_category",
          "title": "Categoría inédita de prueba",
          "enabled": true,
          "fields": [
            {
              "key": "identity",
              "label": "Nombre completo",
              "type": "TEXT",
              "required": false
            },
            {
              "key": "born",
