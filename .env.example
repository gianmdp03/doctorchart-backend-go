# Copy to .env and supply local values. Real credentials belong only in .env.
PORT=8083
DATABASE_URL=postgresql://doctorchart:replace-me@localhost:5432/doctorchart
# Same value in Gateway, DoctorChart and Pointly; at least 32 characters.
GATEWAY_SHARED_SECRET=
SERVICES_BILLING_URL=http://localhost:8081
# Same value in Billing and its callback receivers; distinct from Gateway.
SERVICES_BILLING_SHARED_SECRET=
STORAGE_TYPE=local
# Absolute directory outside this repository; single quotes preserve backslashes.
STUDIES_STORAGE_DIR='C:\DoctorChartData\studies'
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Shared image service: same key as APP_DOCTORCHART_API_KEY in the converter.
IMAGE_CONVERTER_URL=http://127.0.0.1:8086
IMAGE_CONVERTER_API_KEY=
# Explicit opt-in for synthetic/local compression tests; false preserves studies.
# Must agree with the converter's doctorchart-study profile mode.
STUDIES_ALLOW_IMAGE_TRANSFORM=true
