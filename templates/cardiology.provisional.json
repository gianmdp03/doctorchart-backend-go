{
  "status": "PROVISIONAL_TEST_ONLY",
  "createSpecialty": {
    "code": "cardiology",
    "name": "Cardiología",
    "description": "Plantilla provisional de consulta cardiológica ambulatoria para revisión profesional.",
    "definition": {
      "schemaVersion": 1,
      "patientForm": {
        "categories": [
          {
            "key": "sys_patient_profile",
            "title": "Datos Personales",
            "fields": [
              {"key": "sys_firstName", "type": "TEXT", "label": "Nombre", "system": true, "required": true},
              {"key": "sys_lastName", "type": "TEXT", "label": "Apellido", "system": true, "required": true},
              {"key": "sys_dni", "type": "TEXT", "label": "DNI", "system": true, "required": true},
              {"key": "sys_dob", "type": "DATE", "label": "Fecha de nacimiento", "system": true, "required": true},
              {
                "key": "sys_sex",
                "type": "SELECT",
                "label": "Sexo",
                "system": true,
                "options": [
                  {"label": "Masculino", "value": "MALE"},
                  {"label": "Femenino", "value": "FEMALE"},
                  {"label": "Otro", "value": "OTHER"},
                  {"label": "Sin información", "value": "UNKNOWN"}
                ],
                "required": true
              },
              {"key": "sys_phone", "type": "TEXT", "label": "Teléfono", "system": true, "required": false},
              {"key": "sys_email", "type": "TEXT", "label": "Email", "system": true, "required": false},
              {"key": "sys_insurance", "type": "TEXT", "label": "Obra social / Cobertura", "system": true, "required": false},
              {"key": "address", "type": "TEXT", "label": "Dirección", "required": false}
            ],
            "system": true,
            "enabled": true
          },
          {
            "key": "cardiovascularHistory",
            "title": "Antecedentes cardiovasculares",
            "enabled": true,
            "fields": [
              {"key": "cardiovascularPersonalHistory", "label": "Antecedentes cardiovasculares personales", "type": "TEXTAREA", "required": false},
              {"key": "priorCardiovascularEvents", "label": "Eventos cardiovasculares previos relevantes", "type": "TEXTAREA", "required": false},
              {"key": "cardiovascularProceduresAndDevices", "label": "Procedimientos y dispositivos cardiovasculares", "type": "TEXTAREA", "required": false},
              {"key": "cardiovascularFamilyHistory", "label": "Antecedentes cardiovasculares familiares", "type": "TEXTAREA", "required": false, "placeholder": "Si se conoce, indicá el parentesco y la edad aproximada al momento del evento."}
            ]
          },
          {
            "key": "cardiovascularRiskFactors",
            "title": "Factores de riesgo cardiovascular",
            "enabled": true,
            "fields": [
              {
                "key": "smokingStatus",
                "label": "Tabaquismo",
                "type": "SELECT",
                "required": false,
                "options": [
                  {"value": "CURRENT", "label": "Actual"},
                  {"value": "FORMER", "label": "Previo"},
                  {"value": "NEVER", "label": "Nunca"},
                  {"value": "UNKNOWN", "label": "Sin información"}
                ]
              },
              {"key": "physicalActivity", "label": "Actividad física", "type": "TEXTAREA", "required": false},
              {"key": "cardiovascularRiskNotes", "label": "Observaciones relevantes", "type": "TEXTAREA", "required": false}
            ]
          },
          {
            "key": "sys_clinical_history",
            "title": "Antecedentes clínicos",
            "enabled": true,
            "fields": [
              {
                "key": "sys_allergyStatus",
                "label": "Alergias conocidas",
                "type": "SELECT",
                "required": false,
                "options": [
                  {"value": "UNKNOWN", "label": "Sin información / no revisado"},
                  {"value": "NONE", "label": "No refiere alergias conocidas"},
                  {"value": "PRESENT", "label": "Tiene alergias conocidas"}
                ]
              },
              {"key": "sys_allergies", "label": "Alergias y reacciones", "type": "TEXTAREA", "required": false, "placeholder": "Una alergia por línea. Incluí la reacción, si se conoce."},
              {
                "key": "sys_conditionStatus",
                "label": "Enfermedades o problemas actuales",
                "type": "SELECT",
                "required": false,
                "options": [
                  {"value": "UNKNOWN", "label": "Sin información / no revisado"},
                  {"value": "NONE", "label": "No refiere enfermedades actuales"},
                  {"value": "PRESENT", "label": "Tiene enfermedades o problemas actuales"}
                ]
              },
              {"key": "sys_conditions", "label": "Enfermedades y problemas de salud", "type": "TEXTAREA", "required": false, "placeholder": "Un problema actual por línea. Ej.: asma en seguimiento."},
              {
                "key": "sys_medicationStatus",
                "label": "Medicación habitual",
                "type": "SELECT",
                "required": false,
                "options": [
                  {"value": "UNKNOWN", "label": "Sin información / no revisado"},
                  {"value": "NONE", "label": "No utiliza medicación habitual"},
                  {"value": "PRESENT", "label": "Utiliza medicación habitual"}
                ]
              },
              {"key": "sys_medications", "label": "Tratamiento habitual", "type": "TEXTAREA", "required": false, "placeholder": "Un medicamento por línea, con dosis y frecuencia cuando se conozcan."},
              {
                "key": "sys_historySource",
                "label": "Origen de la información revisada",
                "type": "SELECT",
                "required": false,
                "options": [
                  {"value": "REPORTED", "label": "Informado por el paciente o su familia"},
                  {"value": "CONFIRMED", "label": "Corroborado por el profesional"}
                ]
              }
            ]
          }
        ]
      },
      "encounterForm": {
        "categories": [
          {
            "key": "reason",
            "title": "Motivo y evolución",
            "enabled": true,
            "fields": [
              {"key": "chiefComplaint", "label": "Motivo de consulta", "type": "TEXTAREA", "required": false},
              {"key": "presentIllness", "label": "Enfermedad actual y evolución", "type": "TEXTAREA", "required": false},
              {"key": "showSymptomDetails", "label": "Mostrar detalle de síntomas", "type": "BOOLEAN", "required": false},
              {
                "key": "symptomDetails",
                "label": "Detalle de síntomas y evolución",
                "type": "TEXTAREA",
                "required": false,
                "visibleWhen": {"fieldKey": "showSymptomDetails", "equals": true}
              }
            ]
          },
          {
            "key": "sys_clinical_history",
            "title": "Antecedentes clínicos",
            "enabled": true,
            "fields": [
              {
                "key": "sys_allergyStatus",
                "label": "Alergias conocidas",
                "type": "SELECT",
                "required": false,
                "options": [
                  {"value": "UNKNOWN", "label": "Sin información / no revisado"},
                  {"value": "NONE", "label": "No refiere alergias conocidas"},
                  {"value": "PRESENT", "label": "Tiene alergias conocidas"}
                ]
              },
              {"key": "sys_allergies", "label": "Alergias y reacciones", "type": "TEXTAREA", "required": false, "placeholder": "Una alergia por línea. Incluí la reacción, si se conoce."},
              {
                "key": "sys_conditionStatus",
                "label": "Enfermedades o problemas actuales",
                "type": "SELECT",
                "required": false,
                "options": [
                  {"value": "UNKNOWN", "label": "Sin información / no revisado"},
                  {"value": "NONE", "label": "No refiere enfermedades actuales"},
                  {"value": "PRESENT", "label": "Tiene enfermedades o problemas actuales"}
                ]
              },
              {"key": "sys_conditions", "label": "Enfermedades y problemas de salud", "type": "TEXTAREA", "required": false, "placeholder": "Un problema actual por línea. Ej.: asma en seguimiento."},
              {
                "key": "sys_medicationStatus",
                "label": "Medicación habitual",
                "type": "SELECT",
                "required": false,
                "options": [
                  {"value": "UNKNOWN", "label": "Sin información / no revisado"},
                  {"value": "NONE", "label": "No utiliza medicación habitual"},
                  {"value": "PRESENT", "label": "Utiliza medicación habitual"}
                ]
              },
              {"key": "sys_medications", "label": "Tratamiento habitual", "type": "TEXTAREA", "required": false, "placeholder": "Un medicamento por línea, con dosis y frecuencia cuando se conozcan."},
              {
                "key": "sys_historySource",
                "label": "Origen de la información revisada",
                "type": "SELECT",
                "required": false,
                "options": [
                  {"value": "REPORTED", "label": "Informado por el paciente o su familia"},
                  {"value": "CONFIRMED", "label": "Corroborado por el profesional"}
                ]
              }
            ]
          },
          {
            "key": "vitals",
            "title": "Signos vitales y mediciones",
            "enabled": true,
            "fields": [
              {"key": "systolicBloodPressure", "label": "Presión arterial sistólica", "type": "NUMBER", "required": false, "unit": "mmHg"},
              {"key": "diastolicBloodPressure", "label": "Presión arterial diastólica", "type": "NUMBER", "required": false, "unit": "mmHg"},
              {"key": "heartRate", "label": "Frecuencia cardíaca", "type": "NUMBER", "required": false, "unit": "lpm"},
              {"key": "weightKg", "label": "Peso", "type": "NUMBER", "required": false, "unit": "kg"},
              {"key": "heightCm", "label": "Talla", "type": "NUMBER", "required": false, "unit": "cm"},
              {"key": "measurementContext", "label": "Origen o contexto de las mediciones", "type": "TEXT", "required": false}
            ]
          },
          {
            "key": "cardiovascularExam",
            "title": "Examen cardiovascular",
            "enabled": true,
            "fields": [
              {"key": "physicalExam", "label": "Examen cardiovascular", "type": "TEXTAREA", "required": false, "placeholder": "Registrá los hallazgos relevantes o las limitaciones si corresponde."}
            ]
          },
          {
            "key": "complementaryStudies",
            "title": "Estudios complementarios",
            "enabled": true,
            "fields": [
              {"key": "reviewedStudies", "label": "Estudios revisados y hallazgos", "type": "TEXTAREA", "required": false},
              {"key": "pendingStudies", "label": "Estudios solicitados o pendientes", "type": "TEXTAREA", "required": false}
            ]
          },
          {
            "key": "assessment",
            "title": "Evaluación y diagnósticos",
            "enabled": true,
            "fields": [
              {"key": "clinicalAssessment", "label": "Impresión clínica", "type": "TEXTAREA", "required": false},
              {"key": "diagnosis", "label": "Diagnóstico principal", "type": "TEXTAREA", "required": false},
              {"key": "otherAssessedProblems", "label": "Otros problemas evaluados", "type": "TEXTAREA", "required": false}
            ]
          },
          {
            "key": "plan",
            "title": "Tratamiento y seguimiento",
            "enabled": true,
            "fields": [
              {"key": "treatment", "label": "Tratamiento e indicaciones", "type": "TEXTAREA", "required": false},
              {"key": "followUpInstructions", "label": "Indicaciones de seguimiento", "type": "TEXTAREA", "required": false},
              {"key": "followUpDate", "label": "Próximo control", "type": "DATE", "required": false}
            ]
          }
        ]
      },
      "modulesConfig": {
        "MEDICATION_CATALOG": true,
        "AI_ASSISTANT": false,
        "GROWTH_CHARTS": false
      }
    }
  },
  "experience": {
    "navigation": ["DASHBOARD", "PATIENTS", "WIZARD"],
    "patientRecordTabs": ["SUMMARY", "ENCOUNTERS", "PRESCRIPTIONS", "STUDIES"],
    "patientRecordActions": ["EDIT_PATIENT", "NEW_ENCOUNTER", "PRINT_DOCUMENT"]
  }
}
